# Database
ARETE_DB=data/arete.duckdb

# Backend
# ARETE_LOG_LEVEL=INFO
# ARETE_AUTO_SYNC_HOUR=3     # local hour of the nightly Garmin + Strava sync (unset = off)

# LLM provider: ollama | openrouter | github
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENROUTER_API_KEY=sk-or-...   # https://openrouter.ai (pay-per-token)
# GITHUB_TOKEN=ghp_...           # GitHub Models

# Strava OAuth app (https://www.strava.com/settings/api)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback
# FRONTEND_URL=http://localhost:3080

# Garmin Connect (optional: the Settings page can log in interactively)
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# ARETE_GARMIN_TOKENS_DIR=data/garmin_tokens   # where Garmin session tokens are stored

ARETE_DB=data/arete.duckdb
MLFLOW_TRACKING_URI=./mlruns

# LLM Provider: ollama | openrouter | github
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenRouter (cloud, pay-per-token — https://openrouter.ai)
# OPENROUTER_API_KEY=sk-or-...

# GitHub Models (included in Copilot Enterprise)
# GITHUB_TOKEN=ghp_...
